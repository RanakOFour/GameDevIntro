RE_Shader     --> RE_AssetFile
RE_Shader     --> RE_Vec2
RE_Shader     --> RE_Vec3
RE_Shader     --> RE_Vec4
RE_Texture    --> RE_AssetFile
RE_Model      --> RE_AssetFile
RE_AssetAudio --> RE_AssetFile
RE_Assets     --> RE_LuaFile
RE_Assets     --> RE_AssetAudio
RE_Assets     --> RE_Model
RE_Assets     --> RE_Shader
RE_Assets     --> RE_Texture
RE_Assets     --> RE_AssetMgr

RE_Rule       --> RE_EntReg
RE_Scene      --> RE_EntReg
RE_Scene      --> RE_CatFactory
RE_Scene      --> RE_Rule
RE_Scene      --> RE_LuaFile
RE_Scene      --> RE_LuaCtx
RE_LuaCtx     --> RE_LuaFile
RE_LuaCtx     --> RE_CatFactory
RE_LuaCtx     --> RE_Rule
RE_LuaCtx     --> RE_Log
RE_Camera     --> RE_Math
RE_Camera     --> RE_LuaCtx
RE_CoreMgr    --> RE_Vec3
RE_Raycast    --> RE_Math
RE_Core       --> RE_Raycast
RE_Core       --> RE_Camera
RE_Core       --> RE_LuaCtx
RE_Core       --> RE_CoreMgr
RE_Core       --> RE_CatFactory
RE_Core       --> RE_Category
RE_Core       --> RE_Scene
RE_Core       --> RE_Rule

RE_MouseInfo  --> RE_Math
RE_Window     --> RE_Math
RE_IOMgr      --> RE_Vec2
RE_IOMgr      --> RE_KBInfo
RE_IOMgr      --> RE_MouseInfo
RE_IO         --> RE_MouseInfo
RE_IO         --> RE_KBInfo
RE_IO         --> RE_IOAudio
RE_IO         --> RE_Window
RE_IO         --> RE_IOMgr

RE_PhysBody   --> RE_Math
RE_PhysMgr    --> RE_Math
RE_Physics    --> RE_PhysMgr
RE_Physics    --> RE_PhysBody

RE_UIRenderer --> RE_IO
RE_UIRenderer --> RE_Math
RE_UI         --> RE_UIRenderer

RE_Root       --> RE_Math
RE_Root       --> RE_Log
RE_Root       --> RE_Assets
RE_Root       --> RE_Core
RE_Root       --> RE_IO
RE_Root       --> RE_Physics
RE_Root       --> RE_UI

' ═══════════════════════════════════════════
' Editor internal edges
' ═══════════════════════════════════════════
ED_Gizmo          --> RE_Math
ED_Serializer --> RE_Root
ED_BuiltinCat     --> RE_Root
ED_BuiltinRules   --> RE_Root

ED_ACTree         --> RE_Root
ED_ConsPanel      --> RE_LogMgr

ED_EntityPanel    --> RE_Root
ED_CamPanel       --> RE_Root
ED_CatPanel       --> RE_Root
ED_RulesPanel     --> RE_Root
ED_PropPanel      --> RE_Root
ED_TutPanel       --> RE_Root

ED_ProjScreen     --> RE_Root

ED_Editor         --> RE_Root
ED_Editor         --> ED_Project
ED_Editor         --> ED_StateReg
ED_Editor         --> ED_Undo
ED_Editor         --> ED_TutReg
ED_Editor         --> ED_TutPanel
ED_Editor         --> ED_TopBar
ED_Editor         --> ED_ThemeMgr
ED_Editor         --> ED_ThemePanel

ED_SceneTab       --> RE_Root
ED_SceneTab       --> ED_Editor
ED_SceneTab       --> ED_EntityPanel
ED_SceneTab       --> ED_CatPanel
ED_SceneTab       --> ED_RulesPanel
ED_SceneTab       --> ED_PropPanel
ED_SceneTab       --> ED_CamPanel
ED_SceneTab       --> ED_SceneSettings
ED_SceneTab       --> ED_SceneSettPanel
ED_SceneTab       --> ED_ConsPanel
ED_SceneTab       --> ED_AssetPanel
ED_SceneTab       --> ED_Gizmo

ED_TextTab        --> RE_Root
ED_TextTab        --> ED_Editor
ED_TextTab        --> ED_ACTree
ED_TextTab        --> ED_RulesPanel
ED_TextTab        --> ED_CatPanel

@enduml
