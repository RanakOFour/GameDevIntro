@startuml header_dependencies
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60
skinparam ArrowColor #888888
skinparam packageStyle rectangle

hide empty members

package "RanakEngine" <<Rectangle>> {

    package "Math" <<Rectangle>> {
        class "Math.h"              as RE_Math
        class "Vector2.h"           as RE_Vec2
        class "Vector3.h"           as RE_Vec3
        class "Vector4.h"           as RE_Vec4
        class "Quaternion.h"        as RE_Quat
    }

    package "Log" <<Rectangle>> {
        class "Log.h"               as RE_Log
        class "LogManager.h"        as RE_LogMgr
    }

    package "Asset" <<Rectangle>> {
        class "AssetFile.h"         as RE_AssetFile
        class "AssetManager.h"      as RE_AssetMgr
        class "LuaFile.h"           as RE_LuaFile
        class "Shader.h"            as RE_Shader
        class "Texture.h"           as RE_Texture
        class "Model.h"             as RE_Model
        class "Audio (Asset).h"     as RE_AssetAudio
        class "Assets.h"            as RE_Assets
    }

    package "Core" <<Rectangle>> {
        class "EntityRegistry.h"    as RE_EntReg
        class "Category.h"          as RE_Category
        class "CategoryFactory.h"   as RE_CatFactory
        class "Rule.h"              as RE_Rule
        class "Scene.h"             as RE_Scene
        class "LuaContext.h"        as RE_LuaCtx
        class "Camera.h"            as RE_Camera
        class "CoreManager.h"       as RE_CoreMgr
        class "Raycast.h"           as RE_Raycast
        class "Core.h"              as RE_Core
    }

    package "IO" <<Rectangle>> {
        class "KBInfo.h"            as RE_KBInfo
        class "MouseInfo.h"         as RE_MouseInfo
        class "Window.h"            as RE_Window
        class "Audio (IO).h"        as RE_IOAudio
        class "IOManager.h"         as RE_IOMgr
        class "IO.h"                as RE_IO
    }

    package "Physics" <<Rectangle>> {
        class "PhysicsBody.h"       as RE_PhysBody
        class "PhysicsManager.h"    as RE_PhysMgr
        class "Physics.h"           as RE_Physics
    }

    package "UI" <<Rectangle>> {
        class "DefaultFont.h"       as RE_Font
        class "UIRenderer.h"        as RE_UIRenderer
        class "UI.h"                as RE_UI
    }

    class "RanakEngine.h"           as RE_Root
}

' ─────────────────────────────────────────────
' EDITOR
' ─────────────────────────────────────────────
package "Editor" <<Rectangle>> {

    package "Core" <<Rectangle>> {
        class "Project.h"           as ED_Project
        class "StateRegistry.h"     as ED_StateReg
        class "UndoManager.h"       as ED_Undo
        class "TutorialRegistry.h"  as ED_TutReg
        class "Editor.h"            as ED_Editor
    }

    package "UI" <<Rectangle>> {
        class "Panel.h"             as ED_Panel
        class "ThemeManager.h"      as ED_ThemeMgr
    }

    package "Scene" <<Rectangle>> {
        class "SceneSettings.h"     as ED_SceneSettings
        class "Gizmo.h"             as ED_Gizmo
        class "SceneSerializer.h"   as ED_Serializer

        package "BuiltIn" <<Rectangle>> {
            class "BuiltinCategories.h" as ED_BuiltinCat
            class "BuiltinRules.h"      as ED_BuiltinRules
            class "BuiltInTutorials.h"  as ED_BuiltinTut
            class "EditorAssets.h"      as ED_EditorAssets
        }
    }

    package "Support" <<Rectangle>> {
        class "AutoCompleteTree.h"  as ED_ACTree
    }

    package "Panels" <<Rectangle>> {

        package "Panels/Scene" <<Rectangle>> {
            class "EntityPanel.h"       as ED_EntityPanel
            class "CameraPanel.h"       as ED_CamPanel
            class "CategoryPanel.h"     as ED_CatPanel
            class "RulesPanel.h"        as ED_RulesPanel
            class "PropertiesPanel.h"   as ED_PropPanel
            class "ConsolePanel.h"      as ED_ConsPanel
            class "AssetBrowserPanel.h" as ED_AssetPanel
            class "SceneSettingsPanel.h" as ED_SceneSettPanel
        }

        package "Panels/UI" <<Rectangle>> {
            class "TopBar.h"            as ED_TopBar
            class "TutorialPanel.h"     as ED_TutPanel
            class "ThemeSettingsPanel.h" as ED_ThemePanel
        }
    }

    package "Tabs" <<Rectangle>> {
        class "SceneEditTab.h"      as ED_SceneTab
        class "TextEditTab.h"       as ED_TextTab
    }

    package "Project" <<Rectangle>> {
        class "ProjectSelectionScreen.h" as ED_ProjScreen
        class "ProjectExporter.h"        as ED_Exporter
    }
}

